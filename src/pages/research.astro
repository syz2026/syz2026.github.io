---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationList from '../components/PublicationList.astro';
import ResearchCard from '../components/ResearchCard.astro';
import SoftwareCard from '../components/SoftwareCard.astro';
import EmptyState from '../components/EmptyState.astro';
import { publications } from '../data/publications';
import { pages } from '../data/pages';
import { getResearch, getSoftware } from '../lib/collections';

const research = await getResearch();
const software = await getSoftware();
---

<BaseLayout title={pages.research.title} description={pages.research.description}>
  <h1 class="page-title">{pages.research.title}</h1>
  <p class="lede">{pages.research.intro}</p>

  <section class="section" aria-labelledby="publications-heading">
    <h2 id="publications-heading">{pages.research.publicationsHeading}</h2>
    <PublicationList items={publications} />
  </section>

  <section class="section" aria-labelledby="independent-heading">
    <h2 id="independent-heading">{pages.research.independentHeading}</h2>
    {
      research.length > 0 ? (
        <ul class="entries">
          {research.map((entry) => (
            <ResearchCard entry={entry} />
          ))}
        </ul>
      ) : (
        <EmptyState text={pages.research.independentEmpty} />
      )
    }
  </section>

  <section class="section" aria-labelledby="software-heading">
    <h2 id="software-heading">{pages.research.softwareHeading}</h2>
    {
      software.length > 0 ? (
        <ul class="entries">
          {software.map((entry) => (
            <SoftwareCard entry={entry} />
          ))}
        </ul>
      ) : (
        <EmptyState text={pages.research.softwareEmpty} />
      )
    }
  </section>
</BaseLayout>

<style>
  .page-title {
    font-size: clamp(1.7rem, 1.4rem + 1.8vw, 2.1rem);
    letter-spacing: -0.015em;
  }

  .lede {
    max-width: var(--prose-max);
    margin-top: 1rem;
    font-size: 1.06rem;
    color: var(--ink-2);
  }

  .section > h2 {
    margin-bottom: 1.4rem;
  }
</style>
