---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import PublicationList from '../components/PublicationList.astro';
import ResearchCard from '../components/ResearchCard.astro';
import SoftwareCard from '../components/SoftwareCard.astro';
import { publications } from '../data/publications';
import { pages } from '../data/pages';
import { getResearch, getSoftware } from '../lib/collections';

const research = await getResearch();
const software = await getSoftware();
---

<BaseLayout title={pages.research.title} description={pages.research.description}>
  <PageHead title={pages.research.title} lede={pages.research.intro} />

  <section class="section" aria-labelledby="publications-heading">
    <h2 id="publications-heading">{pages.research.publicationsHeading}</h2>
    <PublicationList items={publications} />
  </section>

  {
    research.length > 0 && (
      <section class="section" aria-labelledby="independent-heading">
        <h2 id="independent-heading">{pages.research.independentHeading}</h2>
        <ul class="entries">
          {research.map((entry) => (
            <ResearchCard entry={entry} />
          ))}
        </ul>
      </section>
    )
  }

  {
    software.length > 0 && (
      <section class="section" aria-labelledby="software-heading">
        <h2 id="software-heading">{pages.research.softwareHeading}</h2>
        <ul class="entries">
          {software.map((entry) => (
            <SoftwareCard entry={entry} />
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>

<style>
  .section > h2 {
    margin-bottom: 1.5rem;
  }
</style>
