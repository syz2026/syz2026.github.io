---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pages } from '../data/pages';
---

<BaseLayout title={pages.notFound.title} description={pages.notFound.description} noindex>
  <div class="not-found">
    <svg class="caesura" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
      <path d="M16 6 L11 34"></path>
      <path d="M29 6 L24 34"></path>
    </svg>
    <h1 class="page-title">{pages.notFound.title}</h1>
    <p class="body">{pages.notFound.body}</p>
    <p class="home-row">
      <a href="/"><span aria-hidden="true">&larr; </span>{pages.notFound.homeLabel}</a>
    </p>
  </div>
</BaseLayout>

<style>
  /* A missing page is a caesura: the two slanted strokes players know as
     railroad tracks, a sudden stop in the music. */
  .not-found {
    text-align: center;
    padding-top: 1.5rem;
  }

  /* Stroke weight matches the stems in the harmonic figure, about 1.5px once
     the viewBox scales to the rendered width; the old 3px strokes outweighed
     the footer's end mark. */
  .caesura {
    width: 2.35rem;
    height: auto;
    margin-bottom: 1.4rem;
  }

  .caesura path {
    stroke: var(--accent);
    stroke-width: 1.6;
    stroke-linecap: round;
    fill: none;
  }

  .body {
    margin: 1.1rem auto 0;
    max-width: var(--prose-max);
    color: var(--ink-2);
  }

  .home-row {
    margin-top: 2.25rem;
  }

  .home-row a {
    font-family: var(--font-sans);
    font-size: 0.9rem;
  }
</style>
