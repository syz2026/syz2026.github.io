---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pages } from '../data/pages';
---

<BaseLayout title={pages.notFound.title} description={pages.notFound.description} noindex>
  <div class="not-found">
    <h1 class="page-title">{pages.notFound.title}</h1>
    <p class="body">{pages.notFound.body}</p>
    <p class="home-row">
      <a href="/"><span aria-hidden="true">&larr; </span>{pages.notFound.homeLabel}</a>
    </p>
  </div>
</BaseLayout>

<style>
  .not-found {
    text-align: center;
    padding-top: 1.5rem;
  }

  .body {
    margin: 1.1rem auto 0;
    max-width: var(--prose-max);
    color: var(--ink-2);
  }

  .home-row {
    margin-top: 2.25rem;
  }

  .home-row a {
    font-family: var(--font-sans);
    font-size: 0.9rem;
  }
</style>
