---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pages } from '../data/pages';
---

<BaseLayout
  title={pages.notFound.title}
  description={pages.notFound.description}
  noindex
>
  <h1 class="page-title">{pages.notFound.title}</h1>
  <p class="body">{pages.notFound.body}</p>
  <p class="home-row">
    <a href="/"><span aria-hidden="true">&larr; </span>{pages.notFound.homeLabel}</a>
  </p>
</BaseLayout>

<style>
  .page-title {
    font-size: clamp(1.7rem, 1.4rem + 1.8vw, 2.1rem);
    letter-spacing: -0.015em;
  }

  .body {
    margin-top: 1.1rem;
    max-width: var(--prose-max);
    color: var(--ink-2);
  }

  .home-row {
    margin-top: 2rem;
  }

  .home-row a {
    font-family: var(--font-sans);
    font-size: 0.9rem;
  }
</style>
