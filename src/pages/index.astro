---
import BaseLayout from '../layouts/BaseLayout.astro';
import HarmonicSeries from '../components/HarmonicSeries.astro';
import { profile } from '../data/profile';
import { pages } from '../data/pages';
---

<BaseLayout title={pages.home.title} description={pages.home.description}>
  <header class="home-head">
    <h1 class="name">{profile.name}</h1>
    <p class="tagline">{profile.tagline}</p>
  </header>

  <HarmonicSeries />

  <figure class="headshot">
    <img
      src={profile.headshot}
      alt="Studio headshot of Stephen Zhang in a dark blazer and white shirt, against a plain grey background"
      width="759"
      height="800"
      decoding="async"
    />
  </figure>

  <div class="bio">
    {profile.bio.map((paragraph) => <p>{paragraph}</p>)}
  </div>

  <ul class="contact-links">
    {
      profile.links.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  /* The home page is the title page of the score: the name set in the
     engraved display face, the tagline as a dedication, and the harmonic
     series stated as the theme before the prose begins. */
  .home-head {
    text-align: center;
  }

  .name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.5rem, 1.75rem + 4.4vw, 3.35rem);
    letter-spacing: 0.05em;
    line-height: 1.04;
    text-transform: uppercase;
  }

  .tagline {
    margin-top: 0.8rem;
    font-size: 1.2rem;
    font-style: italic;
    color: var(--ink-2);
  }

  .headshot {
    margin: 0.25rem auto 0.5rem;
    max-width: 14rem;
  }

  .headshot img {
    padding: 0.45rem;
    background: var(--paper-raised);
    border: 1px solid var(--line-strong);
    box-shadow: 0 0 0 1px var(--line);
    filter: saturate(0.86) sepia(0.1) contrast(0.98);
  }

  .bio {
    max-width: var(--prose-max);
  }

  .bio p + p {
    margin-top: 1rem;
  }

  .bio p:first-of-type {
    margin-top: 0.25rem;
  }

  /* A raised initial rather than a dropped one. A drop cap has to cut a
     rectangular column out of the text, which a narrow glyph cannot do, and
     the bio happens to open on "I". Setting the initial on the baseline works
     for any letter, so the opening sentence can be rewritten freely. */
  .bio p:first-of-type::first-letter {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2.15em;
    line-height: 1;
    padding-right: 0.04em;
    color: var(--accent);
  }

  .contact-links {
    clear: both;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.6rem;
    margin: 2.25rem 0 0;
    padding: 1.4rem 0 0;
    border-top: 3px double var(--line-strong);
  }

  .contact-links a {
    font-family: var(--font-sans);
    font-size: 0.95rem;
  }

  @media (min-width: 40rem) {
    .headshot {
      float: right;
      margin: 0.25rem 0 1.25rem 2rem;
      width: 12rem;
    }
  }

  @media (prefers-color-scheme: dark) {
    .headshot img {
      filter: saturate(0.82) sepia(0.08) brightness(0.94);
    }
  }
</style>
