---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
import { pages, ui } from '../data/pages';
---

<BaseLayout title={pages.home.title} description={pages.home.description}>
  <header class="home-head">
    <h1 class="name">{profile.name}</h1>
    <p class="tagline">{profile.tagline}</p>
  </header>

  <figure class="headshot">
    <img src={profile.headshot} alt={ui.headshotAlt} width="759" height="800" decoding="async" />
  </figure>

  <div class="bio">
    {profile.bio.map((paragraph) => <p>{paragraph}</p>)}
  </div>

  <h2 class="visually-hidden">{pages.home.contactHeading}</h2>
  <ul class="contact-links">
    {
      profile.links.map((link) => (
        <li>
          <a
            href={link.href}
            rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .home-head {
    text-align: center;
    margin-bottom: 2.75rem;
  }

  .name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.5rem, 1.75rem + 4.4vw, 3.35rem);
    letter-spacing: 0.05em;
    line-height: 1.04;
    text-transform: uppercase;
  }

  .tagline {
    margin-top: 0.8rem;
    font-size: 1.2rem;
    font-style: italic;
    color: var(--ink-2);
  }

  .headshot {
    margin: 0 auto 1.25rem;
    max-width: 14rem;
  }

  .headshot img {
    border: 1px solid var(--line-strong);
  }

  .bio {
    max-width: var(--prose-max);
  }

  .bio p + p {
    margin-top: 1rem;
  }

  .bio p:first-of-type {
    margin-top: 0.25rem;
  }

  .contact-links {
    clear: both;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.6rem;
    margin: 2.25rem 0 0;
    padding: 1.4rem 0 0;
    border-top: 1px solid var(--line-strong);
  }

  .contact-links a {
    font-family: var(--font-sans);
    font-size: 0.95rem;
  }

  @media (min-width: 40rem) {
    .headshot {
      float: right;
      margin: 0.25rem 0 1.25rem 2rem;
      width: 12rem;
    }
  }
</style>
