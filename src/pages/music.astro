---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import MusicCard from '../components/MusicCard.astro';
import { pages } from '../data/pages';
import { getMusic } from '../lib/collections';

const works = await getMusic();
---

<BaseLayout title={pages.music.title} description={pages.music.description}>
  <PageHead title={pages.music.title} lede={pages.music.intro} />

  {
    works.length > 0 && (
      <section class="section" aria-labelledby="works-heading">
        <h2 id="works-heading">{pages.music.worksHeading}</h2>
        <ul class="entries">
          {works.map((entry) => (
            <MusicCard entry={entry} />
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>

<style>
  .section > h2 {
    margin-bottom: 1.5rem;
  }
</style>
