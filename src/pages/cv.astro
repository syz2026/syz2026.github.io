---
import BaseLayout from '../layouts/BaseLayout.astro';
import PositionList from '../components/PositionList.astro';
import PublicationList from '../components/PublicationList.astro';
import {
  profile,
  education,
  research,
  experience,
  activities,
  awards,
  skills,
} from '../data/profile';
import { publications } from '../data/publications';
import { pages } from '../data/pages';
---

<BaseLayout title={pages.cv.title} description={pages.cv.description}>
  <div class="cv-head">
    <h1 class="page-title">{pages.cv.title}</h1>
    <a class="resume-link" href={profile.resume}>{pages.cv.resumeLabel}</a>
  </div>

  <section class="section first-section" aria-labelledby="cv-education">
    <h2 id="cv-education">{pages.cv.sections.education}</h2>
    <div class="entry">
      <div class="entry-head">
        <h3 class="entry-title">{education.school}</h3>
        <span class="dates">{education.graduation}</span>
      </div>
      <p class="degree">{education.degree}</p>
      <p class="meta">
        <span>Minor: {education.minor}</span>
        <span>{education.location}</span>
      </p>
      <p class="coursework">
        <span class="coursework-label">{pages.cv.courseworkLabel}:</span>{' '}
        {education.coursework.join(', ')}
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="cv-experience">
    <h2 id="cv-experience">{pages.cv.sections.experience}</h2>
    <PositionList items={experience} />
  </section>

  <section class="section" aria-labelledby="cv-research">
    <h2 id="cv-research">{pages.cv.sections.research}</h2>
    <PositionList items={research} />
  </section>

  <section class="section" aria-labelledby="cv-publications">
    <h2 id="cv-publications">{pages.cv.sections.publications}</h2>
    <PublicationList items={publications} />
  </section>

  <section class="section" aria-labelledby="cv-activities">
    <h2 id="cv-activities">{pages.cv.sections.activities}</h2>
    <PositionList items={activities} />
  </section>

  <section class="section" aria-labelledby="cv-awards">
    <h2 id="cv-awards">{pages.cv.sections.awards}</h2>
    <ul class="entries awards">
      {
        awards.map((award) => (
          <li class="entry award">
            <span class="award-title">{award.title}</span>
            <span class="dates">{award.year}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section" aria-labelledby="cv-skills">
    <h2 id="cv-skills">{pages.cv.sections.skills}</h2>
    <div class="entry">
      {
        skills.map((skill) => (
          <p class="skill-row">
            <span class="skill-group">{skill.group}:</span> {skill.items.join(', ')}
          </p>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .cv-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }

  .resume-link {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    padding: 0.45em 0.95em;
    border: 1px solid var(--line-strong);
    border-radius: 3px;
    text-decoration: none;
    color: var(--ink);
  }

  .resume-link:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .resume-link {
      transition:
        color 140ms ease,
        border-color 140ms ease;
    }
  }

  .first-section {
    margin-top: 3rem;
  }

  .section > h2 {
    margin-bottom: 1.5rem;
  }

  .degree {
    margin-top: 0.3rem;
  }

  .entry .meta {
    margin-top: 0.3rem;
  }

  .coursework {
    margin-top: 0.75rem;
    max-width: var(--prose-max);
    font-size: 0.95rem;
    color: var(--ink-2);
  }

  .coursework-label {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    color: var(--ink);
  }

  .award {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.2rem 1.25rem;
    padding: 0.85rem 0 0.9rem;
  }

  .award-title {
    font-size: 0.98rem;
  }

  .skills {
    padding-top: 1.25rem;
  }

  .skill-row {
    font-size: 0.95rem;
    color: var(--ink-2);
  }

  .skill-row + .skill-row {
    margin-top: 0.45rem;
  }

  .skill-group {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    color: var(--ink);
  }
</style>
