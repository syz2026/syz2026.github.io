---
import { profile } from '../data/profile';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <p class="footer-note">
      &copy; {year} {profile.name} <span aria-hidden="true">·</span>
      {profile.location}
    </p>
    <ul class="footer-links">
      {
        profile.links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
  }

  .footer-inner {
    max-width: var(--site-max);
    margin: 0 auto;
    padding: 1.5rem var(--gutter) 2.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
  }

  .footer-note {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--ink-2);
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.2rem;
    margin: 0;
    padding: 0;
  }

  .footer-links a {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--ink-2);
    text-decoration-color: color-mix(in srgb, var(--ink-2) 40%, transparent);
  }

  .footer-links a:hover {
    color: var(--accent);
  }
</style>
