---
import { profile } from '../data/profile';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <svg class="end-mark" viewBox="0 0 36 18" aria-hidden="true" focusable="false">
      <line x1="14" y1="1" x2="14" y2="17"></line>
      <rect x="19" y="1" width="3.4" height="16"></rect>
    </svg>
    {
      /* The spaces are explicit because the template collapses whitespace
        across a line break, and they are real text rather than CSS margin so
        the colophon still reads correctly aloud and when copied. */
    }
    <p class="footer-note">
      <span>&copy; {year} {profile.name}</span>{' '}
      <span class="sep" aria-hidden="true">·</span>{' '}
      <span>{profile.location}</span>
    </p>
    <ul class="footer-links">
      {
        profile.links.map((link) => (
          <li>
            <a
              href={link.href}
              rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
  }

  .footer-inner {
    max-width: var(--site-max);
    margin: 0 auto;
    padding: 2.25rem var(--gutter) 2.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    text-align: center;
  }

  /* The final barline: every page of the site ends on a light-heavy bar,
     the way a movement ends. */
  .end-mark {
    width: 1.55rem;
    height: auto;
  }

  .end-mark line {
    stroke: var(--ink-2);
    stroke-width: 1;
  }

  .end-mark rect {
    fill: var(--ink);
  }

  .footer-note {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--ink-2);
  }

  .sep {
    color: var(--ink-3);
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.35rem 1.2rem;
    margin: 0;
    padding: 0;
  }

  .footer-links a {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--ink-2);
    text-decoration-color: color-mix(in srgb, var(--ink-2) 40%, transparent);
  }

  .footer-links a:hover {
    color: var(--accent);
  }
</style>
