---
import { pages } from '../data/pages';

interface Props {
  src: string;
  title: string;
}

const { src, title } = Astro.props;
---

<figure class="player">
  <figcaption>
    <span class="player-note" aria-hidden="true"></span>
    <span class="player-label">{pages.music.recordingLabel}</span>
    <span class="player-title">{title}</span>
  </figcaption>
  <audio controls preload="none" src={src}>
    <a href={src} download>{pages.music.downloadLabel}</a>
  </audio>
</figure>

<style>
  /* The recording sits in its own bracketed system: double bar above,
     hairline below. */
  .player {
    margin: 1.75rem 0 0;
    padding: 1.2rem 0 1.35rem;
    border-top: 3px double var(--line-strong);
    border-bottom: 1px solid var(--line);
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.75rem;
    margin-bottom: 0.9rem;
  }

  .player-note {
    align-self: center;
    width: 0.62em;
    height: 0.62em;
    border-radius: 50% 50% 50% 50% / 58% 58% 42% 42%;
    background: var(--accent);
    transform: rotate(-16deg);
  }

  .player-label {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .player-title {
    font-style: italic;
    color: var(--ink-2);
    font-size: 0.95rem;
  }

  audio {
    display: block;
    width: 100%;
    height: 2.75rem;
  }
</style>
