---
/**
 * An empty section is notated as a rest: a full-width measure of staff
 * lines holding a single whole rest, with the copy set below like a stage
 * direction. Silence, marked deliberately, rather than missing content.
 * The measure is pure CSS so the lines run edge to edge undistorted.
 */
interface Props {
  text: string;
  /**
   * A page holds at most one notated rest. Where two empty states land on
   * the same page, the rest keeps the full measure and the quiet variant
   * carries the copy alone, so a pair of rests never reads as "no content".
   */
  variant?: 'rest' | 'quiet';
}

const { text, variant = 'rest' } = Astro.props;
---

<div class={`empty-state empty-${variant}`}>
  {
    variant === 'rest' && (
      <div class="measure" aria-hidden="true">
        <span class="rest" />
      </div>
    )
  }
  <p>{text}</p>
</div>

<style>
  .empty-state {
    border-top: 3px double var(--line-strong);
    padding: 2.5rem 0 2.75rem;
  }

  /* The rest measure closes like every other list on the site: a light-heavy
     final barline below, so the silence reads as a movement that has ended
     rather than as a phrase still waiting for its next bar. */
  .empty-state::after {
    content: '';
    display: block;
    margin-top: 2rem;
    border-top: 3px solid var(--ink);
  }

  /* Five staff lines, drawn as backgrounds so they span the full measure. */
  .measure {
    position: relative;
    height: 4rem;
    background-image:
      linear-gradient(var(--line-strong), var(--line-strong)),
      linear-gradient(var(--line-strong), var(--line-strong)),
      linear-gradient(var(--line-strong), var(--line-strong)),
      linear-gradient(var(--line-strong), var(--line-strong)),
      linear-gradient(var(--line-strong), var(--line-strong));
    background-size: 100% 1px;
    background-repeat: no-repeat;
    background-position:
      0 0.5rem,
      0 1.25rem,
      0 2rem,
      0 2.75rem,
      0 3.5rem;
  }

  /* Barlines bounding the measure. */
  .measure::before,
  .measure::after {
    content: '';
    position: absolute;
    top: 0.5rem;
    width: 1px;
    height: 3.0625rem;
    background: var(--line-strong);
  }

  .measure::before {
    left: 0;
  }

  .measure::after {
    right: 0;
  }

  /* A whole rest: the filled block hangs below the second line. */
  .rest {
    position: absolute;
    top: 1.25rem;
    left: 50%;
    width: 0.75rem;
    height: 0.42rem;
    margin-left: -0.375rem;
    background: var(--ink);
  }

  .empty-state p {
    max-width: var(--prose-max);
    margin: 1.75rem auto 0;
    text-align: center;
    font-style: italic;
    color: var(--ink-2);
  }

  /* The quiet variant keeps the measure grammar but drops the staff, so the
     copy carries the silence on its own. */
  .empty-quiet {
    padding: 1.9rem 0 2rem;
  }

  .empty-quiet p {
    margin-top: 0;
  }
</style>
