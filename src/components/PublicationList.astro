---
import type { Publication } from '../data/publications';
import { pages } from '../data/pages';

interface Props {
  items: readonly Publication[];
  /**
   * Off under a heading that already names the review status, where the label
   * would say the same thing twice.
   */
  showKind?: boolean;
}

const { items, showKind = true } = Astro.props;
const kindLabels = pages.research.kindLabels;
---

<ul class="entries">
  {
    items.map((pub) => (
      <li class="entry">
        <h3 class="entry-title">
          {pub.href ? (
            <a href={pub.href} rel="noopener noreferrer">
              {pub.title}
            </a>
          ) : (
            pub.title
          )}
        </h3>
        <p class="authors">
          {pub.authors}{' '}
          {pub.authorshipNote && <span class="authorship">({pub.authorshipNote})</span>}
        </p>
        <p class="meta">
          <span class="venue">
            {pub.venue}
            {pub.detail && `, ${pub.detail}`}
          </span>
          <span>{pub.year}</span>
          {showKind && <span class="kind">{kindLabels[pub.kind]}</span>}
          {pub.secondary && (
            <a href={pub.secondary.href} rel="noopener noreferrer">
              {pub.secondary.label}
            </a>
          )}
        </p>
      </li>
    ))
  }
</ul>

<style>
  .authors {
    margin-top: 0.35rem;
    font-size: 0.95rem;
    color: var(--ink-2);
  }

  .entry .meta {
    margin-top: 0.4rem;
  }

  .venue {
    font-family: var(--font-serif);
    font-size: 0.92rem;
    font-style: italic;
  }

  /* Placeholder treatment only. The design lead should set how the kind and
     the authorship note sit in the meta line. */
  .authorship {
    font-style: italic;
  }

  .kind {
    font-family: var(--font-sans);
    font-size: 0.78rem;
  }
</style>
